# --- Discord (bot BARU, bukan bot Hermes utama) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=        # opsional, dibaca otomatis dari token
DISCORD_GUILD_ID=         # opsional; kosong = daftar command di semua server tempat bot berada

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/mic   # di docker compose otomatis mongodb://mongo:27017/mic

# --- LLM (OpenAI-compatible) ---
# Mode A (default): OpenRouter + model Hermes. Stateless, tanpa memori sama sekali.
LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
BACKUP_OPENROUTER_API_KEY=     # opsional, dipakai otomatis kalau key utama gagal/limit
LLM_TEXT_MODEL=nousresearch/hermes-4-405b,dots-studio/dots-3-note-preview:free   # boleh beberapa, dipisah koma
LLM_VISION_MODEL=google/gemini-2.5-flash,dots-studio/dots-3-note-preview:free
# Mode B: Hermes Agent lokal, profil terpisah "mic" (lihat README bagian Hermes).
# LLM_BASE_URL=http://localhost:8643/v1
# LLM_API_KEY=<API_SERVER_KEY profil mic>
# LLM_TEXT_MODEL=hermes-agent
# LLM_JSON_MODE=false
# Vision boleh tetap lewat OpenRouter:
# LLM_VISION_BASE_URL=https://openrouter.ai/api/v1
# LLM_VISION_API_KEY=

# --- Lain-lain ---
TZ=Asia/Jakarta
# Percepat waktu untuk demo. 1 = normal; 1440 = 1 menit nyata = 1 hari.
DEMO_TIME_SCALE=1
