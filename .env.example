# --- Discord (bot BARU, bukan bot Hermes utama). Kosongkan DISCORD_TOKEN untuk WhatsApp saja ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=        # opsional, dibaca otomatis dari token
DISCORD_GUILD_ID=         # opsional; kosong = daftar command di semua server tempat bot berada
OPERATOR_DISCORD_ID=      # opsional; ID Discord-mu → DM kalau bot sempat mati / scheduler macet

# --- WhatsApp (Baileys, tidak resmi — pakai nomor khusus bot, bukan nomor pribadi) ---
WHATSAPP_ENABLED=false
WA_PHONE_NUMBER=          # nomor bot, angka saja dengan kode negara, mis. 6281234567890
# WA_AUTH_DIR=./data/wa-auth   # sesi login; RAHASIA, sudah di .gitignore

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/mic   # di docker compose otomatis mongodb://mongo:27017/mic

# --- LLM (OpenAI-compatible) ---
# Mode A (default): OpenRouter. Stateless, tanpa memori sama sekali.
LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
BACKUP_OPENROUTER_API_KEY=     # opsional, dipakai otomatis kalau key utama gagal/limit
# Default: GLM 5.3 Flash (berbayar tapi sangat murah, ~2 detik, bisa baca gambar bukti transfer).
# Boleh beberapa model dipisah koma — dicoba berurutan kalau yang depan gagal.
LLM_TEXT_MODEL=z-ai/glm-5.3-flash
LLM_VISION_MODEL=z-ai/glm-5.3-flash
# Pilih penyedia tercepat di OpenRouter (latency|throughput|price|default). Default latency.
# LLM_PROVIDER_SORT=latency
# Tanpa kredit (dev): model gratis, lebih lambat & sering kena rate limit:
# LLM_TEXT_MODEL=dots-studio/dots-3-note-preview:free,google/gemma-4-31b-it:free
# Mode B: Hermes Agent lokal, profil terpisah "mic" (lihat README bagian Hermes).
# LLM_BASE_URL=http://localhost:8643/v1
# LLM_API_KEY=<API_SERVER_KEY profil mic>
# LLM_TEXT_MODEL=hermes-agent
# LLM_JSON_MODE=false
# Vision boleh tetap lewat OpenRouter:
# LLM_VISION_BASE_URL=https://openrouter.ai/api/v1
# LLM_VISION_API_KEY=

# --- Laporan kas di Google Sheets (opsional) — lihat README "Laporan kas di Google Sheets" ---
# Cara utama: bot membuat sheet di Drive bendahara (OAuth client tipe "TVs and Limited Input devices").
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Kunci penyegel login Google di database — acak, >= 32 karakter (openssl rand -base64 48). JANGAN di-commit.
# SECRET_KEY=
# Cara manual (sheet dibagikan ke akun layanan):
# GOOGLE_SERVICE_ACCOUNT_FILE=./data/google-service-account.json

# --- Info lomba otomatis (feed RSS/Atom, https, pisah koma; "off" = mati) ---
# LOMBA_FEEDS=https://www.lombasma.com/feed,https://www.indbeasiswa.com/feed

# --- Lain-lain ---
TZ=Asia/Jakarta
# Percepat waktu untuk demo. 1 = normal; 1440 = 1 menit nyata = 1 hari.
DEMO_TIME_SCALE=1
